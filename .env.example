# Copy to .env for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# Etrynity AI (assistant, Solution Finder, message drafting) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Contact form delivery — https://resend.com (verify the etrynity.com domain there)
RESEND_API_KEY=
# Optional overrides (defaults shown)
# CONTACT_TO=info@etrynity.com
# CONTACT_FROM=Etrynity Website <info@etrynity.com>
# CONTACT_AUTOREPLY=true

# Optional: Google Analytics 4 measurement ID (shows a cookie-consent banner when set)
# PUBLIC_GA_ID=G-XXXXXXXXXX
# Optional: Google Search Console HTML-tag verification token
# PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: canonical site URL. Defaults to Vercel's production domain automatically.
# SITE_URL=https://www.etrynity.com
