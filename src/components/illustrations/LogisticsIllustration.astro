---
interface Props { id?: string }
const { id = "logistics" } = Astro.props;
const pins: [number, number][] = [[70, 368], [292, 334], [500, 300]];
---
<div class="illustration">
  <svg viewBox="0 0 560 460" role="img" aria-labelledby={`${id}-t`}>
    <title id={`${id}-t`}>Illustration: goods moving from a warehouse by truck along a tracked route to shipping containers, with global shipping lanes overhead</title>
    <defs>
      <radialGradient id={`${id}-glow`}><stop offset="0" stop-color="#C9A46A" stop-opacity=".2" /><stop offset="1" stop-color="#C9A46A" stop-opacity="0" /></radialGradient>
    </defs>
    <circle cx="280" cy="250" r="230" fill={`url(#${id}-glow)`} />
    <path d="M60 150Q280 -10 500 150" fill="none" stroke="#C9A46A" stroke-opacity=".3" />
    <path class="flow" d="M60 150Q280 -10 500 150" fill="none" stroke="#E2C792" stroke-width="1.5" />
    <path d="M110 150Q280 40 450 150" fill="none" stroke="#C9A46A" stroke-opacity=".2" stroke-dasharray="2 7" />
    <circle class="pulse" cx="60" cy="150" r="5" fill="#E2C792" />
    <circle class="pulse" cx="500" cy="150" r="5" fill="#E2C792" />
    <path d="M30 396h500" stroke="#C9A46A" stroke-opacity=".25" />
    <path d="M70 368C150 300 210 390 292 334S430 262 500 300" fill="none" stroke="#C9A46A" stroke-opacity=".35" stroke-width="10" stroke-linecap="round" />
    <path class="flow" d="M70 368C150 300 210 390 292 334S430 262 500 300" fill="none" stroke="#E2C792" stroke-width="2" />
    <g>
      <path d="M40 236l70-40 70 40v94H40z" fill="#0F1D33" stroke="#C9A46A" stroke-opacity=".85" stroke-width="1.4" />
      <path d="M78 330v-50h64v50M78 296h64M78 313h64" fill="none" stroke="#C9A46A" stroke-opacity=".6" />
      <path d="M58 248h104" stroke="#C9A46A" stroke-opacity=".35" />
      <text x="110" y="270" text-anchor="middle" fill="#C9A46A" font-family="Manrope Variable, Manrope, sans-serif" font-size="10" font-weight="700" letter-spacing="2.5">WAREHOUSE</text>
    </g>
    <g class="drift">
      <rect x="208" y="226" width="92" height="52" rx="4" fill="#0F1D33" stroke="#E2C792" stroke-width="1.4" />
      <path d="M300 240h26l18 18v20h-44z" fill="#0F1D33" stroke="#E2C792" stroke-width="1.4" />
      <path d="M308 248h14l10 10h-24z" fill="#C9A46A" fill-opacity=".25" stroke="#C9A46A" />
      <circle cx="232" cy="282" r="10" fill="#08111F" stroke="#E2C792" stroke-width="1.4" />
      <circle cx="322" cy="282" r="10" fill="#08111F" stroke="#E2C792" stroke-width="1.4" />
      <path d="M222 244h56M222 258h40" stroke="#C9A46A" stroke-opacity=".5" />
    </g>
    {[[392, 198], [462, 198], [427, 156]].map(([x, y]) => (
      <g>
        <rect x={x} y={y} width="66" height="40" fill="#0C1729" stroke="#C9A46A" stroke-opacity=".8" />
        {[12, 24, 36, 48].map((dx) => <path d={`M${x + dx} ${y + 6}v28`} stroke="#C9A46A" stroke-opacity=".35" />)}
      </g>
    ))}
    {pins.map(([x, y]) => (
      <g>
        <circle class="pulse" cx={x} cy={y} r="14" fill="#E2C792" fill-opacity=".18" />
        <path d={`M${x} ${y}c-7-9-11-14-11-19a11 11 0 0 1 22 0c0 5-4 10-11 19z`} fill="#0F1D33" stroke="#E2C792" stroke-width="1.4" />
        <circle cx={x} cy={y - 19} r="3.5" fill="#E2C792" />
      </g>
    ))}
    <g>
      <rect x="350" y="352" width="170" height="64" rx="10" fill="#0F1D33" stroke="#C9A46A" stroke-opacity=".8" />
      <text x="368" y="377" fill="#F7F2E9" font-family="Manrope Variable, Manrope, sans-serif" font-size="11" font-weight="700" letter-spacing="2">IN TRANSIT</text>
      <rect x="368" y="392" width="134" height="5" rx="2.5" fill="#C9A46A" fill-opacity=".2" />
      <rect x="368" y="392" width="92" height="5" rx="2.5" fill="#E2C792" />
    </g>
  </svg>
</div>
