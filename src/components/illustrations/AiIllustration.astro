---
interface Props { id?: string }
const { id = "ai" } = Astro.props;
const layers = [
  { x: 70, ys: [150, 230, 310] },
  { x: 165, ys: [110, 190, 270, 350] },
  { x: 260, ys: [150, 230, 310] },
];
const edges: [number, number, number, number][] = [];
for (let l = 0; l < layers.length - 1; l++)
  for (const y1 of layers[l].ys) for (const y2 of layers[l + 1].ys) edges.push([layers[l].x, y1, layers[l + 1].x, y2]);
const steps = [
  { y: 82, label: "CAPTURE", sub: "Email · forms · documents" },
  { y: 196, label: "UNDERSTAND", sub: "Classify · extract · decide" },
  { y: 310, label: "ACT", sub: "Update · notify · report" },
];
---
<div class="illustration">
  <svg viewBox="0 0 560 460" role="img" aria-labelledby={`${id}-t`}>
    <title id={`${id}-t`}>Illustration: a neural network feeding an automated workflow that captures, understands and acts on information</title>
    <defs>
      <radialGradient id={`${id}-glow`}><stop offset="0" stop-color="#C9A46A" stop-opacity=".22" /><stop offset="1" stop-color="#C9A46A" stop-opacity="0" /></radialGradient>
    </defs>
    <circle cx="200" cy="230" r="210" fill={`url(#${id}-glow)`} />
    {edges.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="#C9A46A" stroke-opacity=".2" />)}
    <path class="flow" d="M70 230L165 190L260 230" fill="none" stroke="#E2C792" stroke-width="1.8" />
    <path class="flow" d="M70 150L165 270L260 310" fill="none" stroke="#E2C792" stroke-width="1.4" stroke-opacity=".7" />
    {layers.map((l) => l.ys.map((y) => (
      <g>
        <circle cx={l.x} cy={y} r="13" fill="#0C1729" stroke="#C9A46A" stroke-width="1.4" />
        <circle class="pulse" cx={l.x} cy={y} r="4.5" fill="#E2C792" />
      </g>
    )))}
    <path class="flow" d="M273 230h44" fill="none" stroke="#E2C792" stroke-width="1.8" />
    {steps.map((s, i) => (
      <g>
        <rect x="320" y={s.y} width="208" height="70" rx="10" fill="#0F1D33" stroke="#C9A46A" stroke-opacity={i === 1 ? 1 : 0.55} />
        <circle cx="348" cy={s.y + 35} r="13" fill="none" stroke="#C9A46A" />
        <text x="348" y={s.y + 40} text-anchor="middle" fill="#E2C792" font-family="Cormorant Garamond Variable, Georgia, serif" font-size="15" font-weight="600">{i + 1}</text>
        <text x="372" y={s.y + 31} fill="#F7F2E9" font-family="Manrope Variable, Manrope, sans-serif" font-size="12" font-weight="700" letter-spacing="2.5">{s.label}</text>
        <text x="372" y={s.y + 50} fill="#AAB4C3" font-family="Manrope Variable, Manrope, sans-serif" font-size="11.5">{s.sub}</text>
      </g>
    ))}
    <path class="flow" d="M424 152v44M424 266v44" fill="none" stroke="#E2C792" stroke-width="1.6" />
    <g transform="translate(150 40)">
      <g class="drift">
        <path d="M15 0l3.6 10.4L29 14l-10.4 3.6L15 28l-3.6-10.4L1 14l10.4-3.6z" fill="none" stroke="#E2C792" stroke-width="1.4" />
      </g>
    </g>
    <circle cx="40" cy="60" r="2" fill="#C9A46A" /><circle cx="520" cy="420" r="2" fill="#C9A46A" /><circle cx="120" cy="410" r="2" fill="#C9A46A" />
  </svg>
</div>
