---
interface Props { id?: string }
const { id = "it" } = Astro.props;
const lines = [
  [0, 120, 1], [24, 170, 0.55], [24, 96, 0.35], [48, 140, 0.55], [48, 64, 0.85], [24, 190, 0.35], [0, 84, 1], [24, 150, 0.55], [48, 110, 0.35],
];
---
<div class="illustration">
  <svg viewBox="0 0 560 460" role="img" aria-labelledby={`${id}-t`}>
    <title id={`${id}-t`}>Illustration: a code editor connected to a cloud server stack and a deployment terminal</title>
    <defs>
      <linearGradient id={`${id}-g`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#E2C792" /><stop offset="1" stop-color="#7A5A26" /></linearGradient>
      <radialGradient id={`${id}-glow`}><stop offset="0" stop-color="#C9A46A" stop-opacity=".22" /><stop offset="1" stop-color="#C9A46A" stop-opacity="0" /></radialGradient>
    </defs>
    <circle cx="280" cy="230" r="230" fill={`url(#${id}-glow)`} />
    <g class="drift">
      <rect x="338" y="30" width="186" height="170" rx="10" fill="#0C1729" stroke="#C9A46A" stroke-opacity=".6" />
      <text x="358" y="58" fill="#C9A46A" font-family="Manrope Variable, Manrope, sans-serif" font-size="11" font-weight="700" letter-spacing="3">CLOUD</text>
      {[0, 1, 2].map((i) => (
        <g>
          <rect x="358" y={74 + i * 38} width="146" height="28" rx="4" fill="#08111F" stroke="#C9A46A" stroke-opacity=".45" />
          <circle class="pulse" cx="374" cy={88 + i * 38} r="4" fill="#E2C792" />
          <path d={`M390 ${88 + i * 38}h50M450 ${88 + i * 38}h40`} stroke="#C9A46A" stroke-opacity=".4" stroke-width="2" stroke-linecap="round" />
        </g>
      ))}
    </g>
    <rect x="36" y="96" width="330" height="236" rx="12" fill="#0F1D33" stroke={`url(#${id}-g)`} stroke-width="1.5" />
    <path d="M36 128h330" stroke="#C9A46A" stroke-opacity=".3" />
    <circle cx="58" cy="112" r="4.5" fill="#E2C792" />
    <circle cx="74" cy="112" r="4.5" fill="#C9A46A" fill-opacity=".55" />
    <circle cx="90" cy="112" r="4.5" fill="#C9A46A" fill-opacity=".3" />
    <text x="250" y="116" fill="#AAB4C3" font-family="Manrope Variable, Manrope, sans-serif" font-size="11">app.ts</text>
    {lines.map(([indent, w, o], i) => (
      <rect x={60 + indent} y={148 + i * 19} width={w} height="7" rx="3.5" fill="#E2C792" fill-opacity={o} />
    ))}
    <rect class="blink" x={60 + 24 + 150 + 6} y={148 + 7 * 19 - 3} width="3" height="13" fill="#E2C792" />
    <g>
      <rect x="244" y="290" width="280" height="138" rx="10" fill="#08111F" stroke="#C9A46A" stroke-opacity=".7" />
      <text x="264" y="324" fill="#C9A46A" font-family="ui-monospace, Consolas, monospace" font-size="13">&gt; build</text>
      <text x="264" y="352" fill="#AAB4C3" font-family="ui-monospace, Consolas, monospace" font-size="13">&gt; deploy --production</text>
      <circle cx="270" cy="378" r="7" fill="none" stroke="#5BE3A2" stroke-width="1.5" />
      <path d="M266.5 378.5l2.5 2.5 4.5-5" fill="none" stroke="#5BE3A2" stroke-width="1.5" />
      <text x="286" y="383" fill="#D3D9E2" font-family="ui-monospace, Consolas, monospace" font-size="13">live</text>
      <rect x="264" y="400" width="200" height="5" rx="2.5" fill="#C9A46A" fill-opacity=".2" />
      <rect x="264" y="400" width="140" height="5" rx="2.5" fill="#E2C792" />
    </g>
    <path class="flow" d="M250 96C250 56 292 50 338 60" fill="none" stroke="#E2C792" stroke-width="1.6" />
    <path class="flow" d="M120 332C120 384 190 384 244 384" fill="none" stroke="#E2C792" stroke-width="1.6" />
    <path class="flow" d="M500 200v90" fill="none" stroke="#C9A46A" stroke-width="1.4" />
    <circle class="pulse" cx="338" cy="60" r="5" fill="#E2C792" />
    <circle class="pulse" cx="244" cy="384" r="5" fill="#E2C792" />
    <circle class="pulse" cx="500" cy="290" r="5" fill="#E2C792" />
    <circle cx="20" cy="60" r="2" fill="#C9A46A" /><circle cx="540" cy="250" r="2" fill="#C9A46A" /><circle cx="120" cy="400" r="2" fill="#C9A46A" />
  </svg>
</div>
