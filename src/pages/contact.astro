---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactForm from "../components/ContactForm.astro";
import { SITE } from "../data/site";

const crumbs = [{ name: "Home", href: "/" }, { name: "Contact", href: "/contact" }];
const next = [
  "We review your enquiry and reply by email.",
  "We arrange a discovery conversation at a time that suits you.",
  "You receive a clear, phased proposal — no commitment until you're ready.",
];
---
<Base
  title="Contact Etrynity — Discuss Your Project"
  description={`Tell us about your project or challenge. Send an enquiry to Etrynity through our contact form or email ${SITE.email}.`}
  pageType="ContactPage"
  breadcrumbs={crumbs}
>
  <section class="section" style="padding-top:clamp(48px,7vw,96px)" aria-labelledby="page-title">
    <div class="container">
      <div class="split split--top" style="gap:clamp(40px,5vw,80px)">
        <div class="stack">
          <Breadcrumbs items={crumbs} />
          <span class="eyebrow">Contact us</span>
          <h1 class="display" id="page-title" style="font-size:clamp(42px,5.2vw,76px)" data-cascade>Let's discuss <em>your project.</em></h1>
          <p class="lead">Tell us what you're working on — a new platform, a process to automate, a team to scale, a supply chain to fix or skills to build. We'll take it from there.</p>
          <div class="stack-sm" style="margin-top:12px">
            <span class="label" style="color:var(--gold)">What happens next</span>
            <ol class="next-steps">
              {next.map((n, i) => <li><span aria-hidden="true">0{i + 1}</span>{n}</li>)}
            </ol>
          </div>
          <ul class="contact-list" style="margin-top:12px">
            <li>
              <Icon name="mail" class="" />
              <div><span class="label">Email</span><br /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></div>
            </li>
            <li>
              <Icon name="instagram" class="" />
              <div><span class="label">Follow our journey</span><br /><a href={SITE.instagram.url} target="_blank" rel="noopener">{SITE.instagram.handle}<span class="sr-only"> on Instagram (opens in a new tab)</span></a></div>
            </li>
            <li>
              <Icon name="spark" class="" />
              <div><span class="label">Quick question?</span><br /><button type="button" class="text-button" data-ask="How do I start a project with Etrynity?">Ask Etrynity AI</button></div>
            </li>
          </ul>
        </div>
        <ContactForm />
      </div>
    </div>
  </section>
</Base>
<style>
  .next-steps { list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .next-steps li { display: flex; gap: 16px; color: var(--mist-light); }
  .next-steps span { font-family: var(--font-display); font-size: 20px; color: var(--gold); line-height: 1.3; }
  .text-button { background: none; border: 0; padding: 0; color: var(--ivory); font-size: 17px; cursor: pointer; text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 4px; }
  .text-button:hover { color: var(--gold-light); }
</style>
