---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ContentArticle from "../../components/ContentArticle.astro";

export async function getStaticPaths() {
  const items = await getCollection("case-studies", (e) => !e.data.draft);
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}
interface Props { item: CollectionEntry<"case-studies"> }
const { item } = Astro.props;
const { Content } = await render(item);
---
<ContentArticle
  section={{ name: "Case studies", href: "/case-studies" }}
  url={`/case-studies/${item.id}`}
  title={item.data.title}
  description={item.data.description}
  date={item.data.date}
  services={item.data.services}
  kicker={`Case study · ${item.data.industry}`}
  schemaType="Article"
>
  <Content />
</ContentArticle>
